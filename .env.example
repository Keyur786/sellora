# ==============================================================================
# Sellora - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="Sellora"
API_V1_STR="/api/v1"

# Security & Authentication
# In production, generate a high-entropy secret (e.g., openssl rand -hex 32)
SECRET_KEY="sellora-development-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Multi-tenant Auth Provider: "dev_mock", "supabase", or "clerk"
AUTH_PROVIDER="dev_mock"
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sellora
POSTGRES_PASSWORD=sellora_secure_password
POSTGRES_DB=sellora_db
DATABASE_URL=postgresql://sellora:sellora_secure_password@postgres:5432/sellora_db

# Background Task Queue (Redis & Celery)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Next.js Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Sellora"
